# Ubuntu 24.04 only lets programs with a profile like this create the user
# namespaces Chromium's sandbox is built on. The profile confines nothing
# else: it exists to grant that one permission, as Ubuntu's own profiles for
# other Electron apps do.
abi <abi/4.0>,
include <tunables/global>

profile veil-center /opt/veil-center/veil-center flags=(unconfined) {
  userns,

  include if exists <local/veil-center>
}
