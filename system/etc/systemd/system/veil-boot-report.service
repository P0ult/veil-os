# For the automated boot test only. It runs when the machine carries the
# system credential veil.test - which the CI harness passes to QEMU as an
# SMBIOS OEM string, and nothing else sets - or when the kernel is started
# with veil.test=1. It reports on the serial port whether the desktop came
# up, so a build can be judged by more than a screenshot.

[Unit]
Description=Veil OS boot test report
ConditionCredential=|veil.test
ConditionKernelCommandLine=|veil.test=1
After=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/lib/veil/veil-boot-report
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=no
TTYVHangup=no

[Install]
WantedBy=graphical.target
