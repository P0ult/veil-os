#!/bin/bash
# The GRUB package for this machine, installed by the installer inside the
# new system.
#
#     veil-install-bootloader efi|bios    before the boot loader is installed
#     veil-install-bootloader record      after it, from the finishing step
#
# The package that owns the boot loader on an installed system is grub-pc for
# BIOS and grub-efi-amd64 for UEFI, and the two conflict. The live image has
# grub-pc (grub-gfxpayload-lists depends on it); the build keeps a copy of
# each in /usr/lib/veil/bootloader, and this makes sure the right one is
# installed - on UEFI, swapping grub-pc out - so GRUB is kept up to date by
# the system's own updates afterwards.
#
# A failure here is reported but does not stop the installation: the
# installer's boot loader step, which comes next, installs GRUB either way.

set -u
export DEBIAN_FRONTEND=noninteractive

# Kept in the installed system, beside the installer's own logs.
mkdir -p /var/log/installer
exec > >(tee -a /var/log/installer/veil-install-bootloader.log) 2>&1
echo "== $(date -Is) $0 $*"

DIR=/usr/lib/veil/bootloader
log() { echo "veil-install-bootloader: $*"; }

install_pkg() {
    local pkg="$1" deb=""
    for f in "$DIR/${pkg}"_*.deb; do
        [ -f "$f" ] && deb="$f"
    done
    if [ -z "$deb" ]; then
        log "no ${pkg} package in ${DIR}"
        return 0
    fi
    if dpkg -s "$pkg" 2>/dev/null | grep -q '^Status: install ok installed'; then
        log "${pkg} is already installed"
        return 0
    fi
    log "installing $(basename "$deb")"
    # The only conflict in this image is grub-pc against grub-efi-amd64,
    # with grub-gfxpayload-lists depending on grub-pc. dpkg will not replace
    # one with the other by itself, and apt, offline and handed a local
    # package, fails halfway through; so the conflicting side goes first.
    # Removed, not purged: grub-pc's purge deletes files in /boot/grub.
    if [ "$pkg" = grub-efi-amd64 ]; then
        dpkg --remove grub-gfxpayload-lists grub-pc || true
    else
        dpkg --remove grub-efi-amd64 || true
    fi
    dpkg -i --force-confdef --force-confold "$deb" || log "${pkg} did not install"
    # Never leave a half-configured package behind: every later apt command
    # would stop on it.
    dpkg --configure -a || true
    if dpkg -s "$pkg" 2>/dev/null | grep -q '^Status: .* half-'; then
        dpkg --remove --force-remove-reinstreq "$pkg" || true
    fi
    dpkg -l 'grub*' 2>/dev/null | awk '/^ii/ {print "  installed: " $2}'
    return 0
}

# Where GRUB for BIOS lives, as the stable name grub-pc's upgrades look for.
record_bios_disk() {
    dpkg -s grub-pc 2>/dev/null | grep -q '^Status: install ok installed' || return 0
    local disk id=""
    disk="$(grub-probe --target=disk /boot 2>/dev/null)" || return 0
    for link in /dev/disk/by-id/*; do
        case "$link" in *-part*) continue ;; esac
        if [ "$(readlink -f "$link")" = "$disk" ]; then id="$link"; break; fi
    done
    [ -n "$id" ] || id="$disk"
    log "GRUB for BIOS is on ${id}"
    echo "grub-pc grub-pc/install_devices multiselect ${id}" | debconf-set-selections
    echo "grub-pc grub-pc/install_devices_empty boolean false" | debconf-set-selections
}

case "${1:-}" in
    efi)
        # Ubuntu's signed GRUB and shim are part of the image already.
        install_pkg grub-efi-amd64
        ;;
    bios)
        install_pkg grub-pc
        ;;
    record)
        record_bios_disk
        ;;
    *)
        echo "usage: $0 efi|bios|record" >&2
        exit 64
        ;;
esac
exit 0
