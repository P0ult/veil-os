#!/bin/bash
# Read Veil's apps into the page cache, so their first start in the live
# session is not spent decompressing them. See veil-live-preload.service.

set -u

dirs=(/opt/veil-center)
browser_desktop="/usr/share/applications/$(cat /usr/lib/veil/browser-desktop-id 2>/dev/null)"
browser_bin="$(grep -m1 '^Exec=' "$browser_desktop" 2>/dev/null | sed 's/^Exec=//; s/"//g; s/ .*//')"
[ -n "$browser_bin" ] && dirs+=("$(dirname "$(readlink -f "$browser_bin")")")

start=$SECONDS
for d in "${dirs[@]}"; do
    [ -d "$d" ] && find "$d" -type f -print0 | xargs -0 -r cat > /dev/null 2>&1
done
echo "read ${dirs[*]} in $((SECONDS - start))s"
exit 0
